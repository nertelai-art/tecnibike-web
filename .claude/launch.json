{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tecnibike-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tecnibike-dev-node",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "--webpack"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tecnibike-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3100,
      "autoPort": true
    }
  ]
}
