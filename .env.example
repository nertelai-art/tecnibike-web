# Connexió amb la plataforma (API de lloguer). Només al servidor: mai amb el prefix NEXT_PUBLIC_.
# Sense aquestes dues variables, la web fa servir les dades de prova (src/lib/plataforma/dades-prova.ts).
# Els valors van a les variables d'entorn de Vercel (i, per provar en local, a .env.local, que no es puja).

# Arrel de la plataforma, sense barra final. Ex.: l'adreça de producció de la plataforma.
PLATAFORMA_API_URL=

# Clau lligada a la botiga, amb els abasts rental_read i rental_write (lloguer) i web_booking_read i
# web_booking_write (cites del taller). Una sola clau per a tota la web. Es crea al panell de la plataforma.
PLATAFORMA_API_CLAU=

# Opcional: una clau només per a les cites del taller (/api/public/bookings). Sense, les cites fan servir
# PLATAFORMA_API_CLAU, que ha de tenir els abasts web_booking_read i web_booking_write. Si cap de les dues
# els té, el formulari de cita no ensenya hores i demana que truquin: no es desa cap cita en memòria.
PLATAFORMA_CITES_CLAU=

# Opcional: la clau del servei de cita, si la botiga en té més d'un que es reservi a hores.
PLATAFORMA_TALLER_SERVEI=
